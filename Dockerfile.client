# Build the Vite/React client. VITE_* values are baked in at build time,
# so they must be passed as build args (see cloudbuild.yaml / gcp-deploy.sh).
FROM node:20-alpine AS client-builder
WORKDIR /app/client

ARG VITE_NAKAMA_HOST
ARG VITE_NAKAMA_PORT=443
ARG VITE_NAKAMA_SSL=true
ARG VITE_NAKAMA_KEY=defaultkey
ENV VITE_NAKAMA_HOST=$VITE_NAKAMA_HOST \
    VITE_NAKAMA_PORT=$VITE_NAKAMA_PORT \
    VITE_NAKAMA_SSL=$VITE_NAKAMA_SSL \
    VITE_NAKAMA_KEY=$VITE_NAKAMA_KEY

COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/ ./
RUN npm run build

# Serve the static build with nginx (Cloud Run listens on port 8080).
FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=client-builder /app/client/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
