# Local Docker Compose — Nakama service environment (see docker-compose.yml).
# On Render, these are configured via render.yaml / the dashboard.

NAKAMA_DATABASE_USER=nakama
NAKAMA_DATABASE_PASSWORD=nakama_local_dev
NAKAMA_DATABASE_HOST=postgres
NAKAMA_DATABASE_PORT=5432
NAKAMA_DATABASE_NAME=nakama
NAKAMA_DATABASE_SSLMODE=disable

NAKAMA_LOGGER_LEVEL=DEBUG
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_SESSION_ENCRYPTION_KEY=local_dev_encryption_key_min_32_chars
NAKAMA_SOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Client (also see client/.env.example)
VITE_NAKAMA_HOST=127.0.0.1
VITE_NAKAMA_PORT=7350
VITE_NAKAMA_SSL=false
VITE_NAKAMA_KEY=defaultkey
